# Email Management Dashboard - Environment Configuration

# Application
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./email_dashboard.db
# For production: DATABASE_URL=postgresql://user:password@host:5432/dbname

# Email IMAP (these should already be in your root .env file)
EMAIL_SERVER=imap.gmail.com
EMAIL_PORT=993
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# OpenAI (should already be in your root .env file)
OPENAI_API_KEY=your-openai-key

# Authentication
SESSION_SECRET=change-this-to-a-random-secret-in-production
SESSION_EXPIRY_HOURS=24
# Generate admin password hash using: python scripts/generate_password_hash.py
ADMIN_PASSWORD_HASH=

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
