{
  "environment": "dev",
  "api": {
    "base_url": "https://api-dev.example.com",
    "timeout": 30,
    "retry_attempts": 3
  },
  "logging": {
    "level": "DEBUG",
    "format": "detailed",
    "output": ["console", "file"]
  },
  "features": {
    "enable_caching": true,
    "enable_validation": true,
    "enable_metrics": false
  },
  "limits": {
    "max_records_per_batch": 100,
    "max_file_size_mb": 10
  }
}
