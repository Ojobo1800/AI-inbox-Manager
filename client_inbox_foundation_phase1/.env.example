ENVIRONMENT=dev
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Gmail API
GOOGLE_CLOUD_PROJECT=
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_VERIFICATION_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_WORKSPACE_USER=
GMAIL_USER_ID=me
GMAIL_WATCH_LABEL_IDS=INBOX
GMAIL_WATCH_LABEL_FILTER_ACTION=include

# Google OAuth (user sign-in)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback
GOOGLE_OAUTH_SCOPES=openid,email,profile

# Google Sheets
GOOGLE_SHEET_ID=
GOOGLE_SHEET_WORKSHEET=InterviewTracker

# SQL Server
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DB=InterviewTracker
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=

# n8n
N8N_BASE_URL=http://localhost:5678
